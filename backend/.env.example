SUPABASE_URL="your-supabase-url"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

JWT_SECRET="your-jwt-secret"
JWT_REFRESH_SECRET="your-jwt-refresh-secret"
PORT=4000
CADT_EMAIL_DOMAIN="@student.cadt.edu.kh"
NOTIFICATION_TRANSPORT="websocket"

# SMTP (nodemailer)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="JorJek <noreply@your-domain>"

# For logging into the database
DATABASE_URL="postgresql://user:password@host:port/dbname"

# ─── HTTPS email API (Resend) — REQUIRED for Render free tier ─────────
# Render free blocks outbound SMTP (465/587) but allows HTTPS (443).
# Set RESEND_API_KEY and the backend sends via Resend automatically,
# skipping SMTP entirely. Works with your existing sendMail() calls.
#
# from must be a domain you verified in Resend; fallback that only
# delivers to your OWN inbox: onboarding@resend.dev
RESEND_API_KEY="re_PASTE_YOUR_KEY_HERE"
RESEND_FROM="JorJek <noreply@your-verified-domain>"